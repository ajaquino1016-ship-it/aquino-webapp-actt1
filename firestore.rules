rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'role', 'companyOrStudio', 'storageUsedBytes', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 64)) &&
             (!('companyOrStudio' in data) || (data.companyOrStudio is string && data.companyOrStudio.size() <= 120)) &&
             (!('storageUsedBytes' in data) || (data.storageUsedBytes is number && data.storageUsedBytes >= 0)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for FavoriteRecipe
    function isValidFavoriteRecipe(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'description', 'totalTimeMinutes', 'difficulty', 'servings', 'savedAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'name', 'description', 'cuisine', 'mood', 'totalTimeMinutes',
               'prepTimeMinutes', 'cookTimeMinutes', 'difficulty', 'servings',
               'dietTags', 'ingredientsHave', 'ingredientsNeed', 'steps',
               'tips', 'nutrition', 'savedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 180 &&
             data.description is string && data.description.size() <= 400 &&
             (!('cuisine' in data) || (data.cuisine is string && data.cuisine.size() <= 64)) &&
             (!('mood' in data) || (data.mood is string && data.mood.size() <= 64)) &&
             data.totalTimeMinutes is number && data.totalTimeMinutes >= 0 && data.totalTimeMinutes <= 1440 &&
             (!('prepTimeMinutes' in data) || (data.prepTimeMinutes is number && data.prepTimeMinutes >= 0 && data.prepTimeMinutes <= 1440)) &&
             (!('cookTimeMinutes' in data) || (data.cookTimeMinutes is number && data.cookTimeMinutes >= 0 && data.cookTimeMinutes <= 1440)) &&
             data.difficulty is string && data.difficulty.size() <= 32 &&
             data.servings is number && data.servings >= 1 && data.servings <= 12 &&
             (!('dietTags' in data) || (data.dietTags is list && data.dietTags.size() <= 12)) &&
             (!('ingredientsHave' in data) || (data.ingredientsHave is list && data.ingredientsHave.size() <= 60)) &&
             (!('ingredientsNeed' in data) || (data.ingredientsNeed is list && data.ingredientsNeed.size() <= 60)) &&
             (!('steps' in data) || (data.steps is list && data.steps.size() <= 40)) &&
             (!('tips' in data) || (data.tips is list && data.tips.size() <= 20)) &&
             (!('nutrition' in data) || data.nutrition is map) &&
             data.savedAt is string && data.savedAt.size() <= 64;
    }

    // Validation for SearchHistoryItem
    function isValidSearchHistoryItem(data) {
      return data.keys().hasAll(['id', 'userId', 'ingredients', 'filters', 'recipes', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'ingredients', 'filters', 'recipes', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.ingredients is list && data.ingredients.size() <= 50 &&
             data.filters is map &&
             data.recipes is list && data.recipes.size() <= 5 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation for UserFilterPreferences
    function isValidUserFilterPreferences(data) {
      return data.keys().hasAll(['userId', 'diet', 'servings', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'maxTimeMinutes', 'diet', 'cuisine', 'mood', 'servings', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             (!('maxTimeMinutes' in data) || data.maxTimeMinutes == null || (data.maxTimeMinutes is number && data.maxTimeMinutes >= 0 && data.maxTimeMinutes <= 1440)) &&
             data.diet is string && data.diet.size() <= 64 &&
             (!('cuisine' in data) || (data.cuisine is string && data.cuisine.size() <= 64)) &&
             (!('mood' in data) || (data.mood is string && data.mood.size() <= 64)) &&
             data.servings is number && data.servings >= 1 && data.servings <= 12 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Validation for UserStreakData
    function isValidUserStreakData(data) {
      return data.keys().hasAll([
               'userId', 'visitStreak', 'bestVisitStreak', 'cookingStreak',
               'bestCookingStreak', 'freezes', 'cookedDates', 'freezeDates',
               'unlockedBadges', 'celebratedMilestones', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'visitStreak', 'bestVisitStreak', 'lastVisitDate',
               'cookingStreak', 'bestCookingStreak', 'lastCookedDate',
               'freezes', 'cookedDates', 'freezeDates', 'unlockedBadges',
               'celebratedMilestones', 'monthlyRecipeCounts',
               'pendingFreezeNotice', 'freshStartNotice', 'settings', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.visitStreak is number && data.visitStreak >= 0 && data.visitStreak <= 10000 &&
             data.bestVisitStreak is number && data.bestVisitStreak >= 0 && data.bestVisitStreak <= 10000 &&
             (!('lastVisitDate' in data) || data.lastVisitDate == null || (data.lastVisitDate is string && data.lastVisitDate.size() <= 16)) &&
             data.cookingStreak is number && data.cookingStreak >= 0 && data.cookingStreak <= 10000 &&
             data.bestCookingStreak is number && data.bestCookingStreak >= 0 && data.bestCookingStreak <= 10000 &&
             (!('lastCookedDate' in data) || data.lastCookedDate == null || (data.lastCookedDate is string && data.lastCookedDate.size() <= 16)) &&
             data.freezes is number && data.freezes >= 0 && data.freezes <= 2 &&
             data.cookedDates is list && data.cookedDates.size() <= 2000 &&
             data.freezeDates is list && data.freezeDates.size() <= 500 &&
             data.unlockedBadges is list && data.unlockedBadges.size() <= 20 &&
             data.celebratedMilestones is list && data.celebratedMilestones.size() <= 20 &&
             (!('monthlyRecipeCounts' in data) || data.monthlyRecipeCounts is map) &&
             (!('pendingFreezeNotice' in data) || data.pendingFreezeNotice is bool) &&
             (!('freshStartNotice' in data) || data.freshStartNotice is bool) &&
             (!('settings' in data) || data.settings is map) &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // User Profile and private PantryAI subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // PII protection: disable listing users
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Saved favorite recipes
      match /favorites/{recipeId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId) && isValidId(recipeId);
        allow create: if isOwner(userId) && isValidId(recipeId) &&
                         isValidFavoriteRecipe(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(recipeId) &&
                         isValidFavoriteRecipe(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(recipeId);
      }

      // Subcollection: Recent search history
      match /history/{historyId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId) && isValidId(historyId);
        allow create: if isOwner(userId) && isValidId(historyId) &&
                         isValidSearchHistoryItem(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(historyId) &&
                         isValidSearchHistoryItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(historyId);
      }

      // Subcollection: User filter preferences
      match /preferences/{prefId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId) && isValidId(prefId);
        allow create: if isOwner(userId) && isValidId(prefId) &&
                         isValidUserFilterPreferences(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(prefId) &&
                         isValidUserFilterPreferences(incoming()) &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(prefId);
      }

      // Subcollection: App streak data
      match /streak/{streakId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId) && isValidId(streakId);
        allow create: if isOwner(userId) && isValidId(streakId) &&
                         isValidUserStreakData(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(streakId) &&
                         isValidUserStreakData(incoming()) &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(streakId);
      }
    }
  }
}
