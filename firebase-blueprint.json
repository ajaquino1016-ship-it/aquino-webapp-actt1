{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing account information and preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID of the user.",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user.",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user.",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Account role.",
          "maxLength": 64
        },
        "storageUsedBytes": {
          "type": "number",
          "description": "Legacy field kept for backwards compatibility."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account registration.",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile update.",
          "maxLength": 64
        }
      },
      "required": ["userId", "email", "displayName"]
    },
    "FavoriteRecipe": {
      "title": "FavoriteRecipe",
      "description": "Saved recipe favorite belonging to a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique favorite identifier.",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Recipe name.",
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "description": "Short one-line recipe summary.",
          "maxLength": 400
        },
        "cuisine": {
          "type": "string",
          "description": "Cuisine style tag.",
          "maxLength": 64
        },
        "mood": {
          "type": "string",
          "description": "Recipe mood tag.",
          "maxLength": 64
        },
        "totalTimeMinutes": {
          "type": "number",
          "description": "Total prep plus cook time in minutes."
        },
        "prepTimeMinutes": {
          "type": "number",
          "description": "Prep time in minutes."
        },
        "cookTimeMinutes": {
          "type": "number",
          "description": "Cook time in minutes."
        },
        "difficulty": {
          "type": "string",
          "description": "Easy, Medium, or Hard.",
          "maxLength": 32
        },
        "servings": {
          "type": "number",
          "description": "Number of servings."
        },
        "dietTags": {
          "type": "array",
          "description": "Applicable dietary tags."
        },
        "ingredientsHave": {
          "type": "array",
          "description": "Ingredients the user has."
        },
        "ingredientsNeed": {
          "type": "array",
          "description": "Extra ingredients needed to buy."
        },
        "steps": {
          "type": "array",
          "description": "Numbered beginner-friendly steps."
        },
        "tips": {
          "type": "array",
          "description": "Cooking tips and substitutions."
        },
        "nutrition": {
          "type": "object",
          "description": "Estimated nutrition per serving."
        },
        "savedAt": {
          "type": "string",
          "description": "ISO timestamp when saved.",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "name", "description", "totalTimeMinutes", "difficulty", "servings", "savedAt"]
    },
    "SearchHistoryItem": {
      "title": "SearchHistoryItem",
      "description": "Recent recipe search performed by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique search history identifier.",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "maxLength": 128
        },
        "ingredients": {
          "type": "array",
          "description": "Ingredient chips used for the search."
        },
        "filters": {
          "type": "object",
          "description": "Filters used (maxTimeMinutes, diet, servings)."
        },
        "recipes": {
          "type": "array",
          "description": "The recipes returned for this search."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of search.",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "ingredients", "filters", "recipes", "createdAt"]
    },
    "UserFilterPreferences": {
      "title": "UserFilterPreferences",
      "description": "Last-used recipe search filters for a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "maxLength": 128
        },
        "maxTimeMinutes": {
          "type": "number",
          "description": "0 for Any, or 15, 30, 60."
        },
        "diet": {
          "type": "string",
          "description": "Selected diet filter.",
          "maxLength": 64
        },
        "cuisine": {
          "type": "string",
          "description": "Selected cuisine filter.",
          "maxLength": 64
        },
        "mood": {
          "type": "string",
          "description": "Selected mood filter.",
          "maxLength": 64
        },
        "servings": {
          "type": "number",
          "description": "Servings count 1 to 6."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when updated.",
          "maxLength": 64
        }
      },
      "required": ["userId", "diet", "servings", "updatedAt"]
    },
    "UserStreakData": {
      "title": "UserStreakData",
      "description": "Per-user visit streak, cooking streak, freezes, badges, cooked date history, and reminder settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID.",
          "maxLength": 128
        },
        "visitStreak": {
          "type": "number",
          "description": "Current consecutive days visited."
        },
        "bestVisitStreak": {
          "type": "number",
          "description": "Longest visit streak."
        },
        "lastVisitDate": {
          "type": "string",
          "description": "Last local date (YYYY-MM-DD) visited.",
          "maxLength": 16
        },
        "cookingStreak": {
          "type": "number",
          "description": "Current consecutive days cooked."
        },
        "bestCookingStreak": {
          "type": "number",
          "description": "Longest cooking streak."
        },
        "lastCookedDate": {
          "type": "string",
          "description": "Last local date (YYYY-MM-DD) cooked.",
          "maxLength": 16
        },
        "freezes": {
          "type": "number",
          "description": "Stored Streak Freezes (0 to 2)."
        },
        "cookedDates": {
          "type": "array",
          "description": "Local dates cooked (YYYY-MM-DD)."
        },
        "freezeDates": {
          "type": "array",
          "description": "Local dates preserved by a Streak Freeze."
        },
        "unlockedBadges": {
          "type": "array",
          "description": "Earned badge identifiers."
        },
        "celebratedMilestones": {
          "type": "array",
          "description": "Milestones already celebrated."
        },
        "monthlyRecipeCounts": {
          "type": "object",
          "description": "Recipes cooked per YYYY-MM month."
        },
        "pendingFreezeNotice": {
          "type": "boolean",
          "description": "Whether to show the freeze-saved notice."
        },
        "freshStartNotice": {
          "type": "boolean",
          "description": "Whether to show the fresh-start encouragement."
        },
        "settings": {
          "type": "object",
          "description": "Notification and reminder settings."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last streak update.",
          "maxLength": 64
        }
      },
      "required": ["userId", "visitStreak", "bestVisitStreak", "cookingStreak", "bestCookingStreak", "freezes", "cookedDates", "freezeDates", "unlockedBadges", "celebratedMilestones", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user account profile."
    },
    "/users/{userId}/favorites/{recipeId}": {
      "schema": {
        "$ref": "#/entities/FavoriteRecipe"
      },
      "description": "Saved favorite recipes per user."
    },
    "/users/{userId}/history/{historyId}": {
      "schema": {
        "$ref": "#/entities/SearchHistoryItem"
      },
      "description": "Recent ingredient searches and results per user."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": {
        "$ref": "#/entities/UserFilterPreferences"
      },
      "description": "Last-used filter preferences per user."
    },
    "/users/{userId}/streak/{streakId}": {
      "schema": {
        "$ref": "#/entities/UserStreakData"
      },
      "description": "Visit and cooking streak state, freezes, badges, and calendar history per user."
    }
  }
}
